---
import type { ApiReferenceDataset } from "@sorrell/docs-api-reference";
import type { ApiReferenceRecord } from "@sorrell/docs-core";
import dataset from "../../data/ApiReference.json";
import ApiPackageLayout from "../../layouts/ApiPackageLayout.astro";
import ApiReferenceLayout from "../../layouts/ApiReferenceLayout.astro";

interface ApiPageProps {
    readonly record: ApiReferenceRecord;
    readonly view: "module" | "package";
}

export function getStaticPaths() {
    const apiDataset = dataset as ApiReferenceDataset;
    const packageRecords = [ ...new Map(apiDataset.records.map((record) => [record.packageId, record])).values()];
    const packagePages = packageRecords.map((record) => ({ params: { slug: record.packageId }, props: { record, view: "package" as const } }));
    const modulePages = apiDataset.records.map((record) => {
        const modulePath = record.module === record.packageId
            ? "Core"
            : record.module.startsWith(`${record.packageId}/`)
                ? record.module.slice(record.packageId.length + 1)
                : record.module;
        return { params: { slug: `${record.packageId}/${modulePath}` }, props: { record, view: "module" as const } };
    });
    return [ ...packagePages, ...modulePages ];
}

const { record, view } = Astro.props as ApiPageProps;
---

{view === "package" ? <ApiPackageLayout record={record} /> : <ApiReferenceLayout record={record} />}
