---
import type { ApiReferenceDataset } from "@sorrell/docs-api-reference";
import type { ApiReferenceRecord } from "@sorrell/docs-core";
import dataset from "../../data/ApiReference.json";
import ApiPackageLayout from "../../layouts/ApiPackageLayout.astro";
import ApiReferenceLayout from "../../layouts/ApiReferenceLayout.astro";

interface ApiPageProps {
    readonly record: ApiReferenceRecord;
    readonly packageModules: readonly ApiReferenceRecord[];
    readonly view: "module" | "package";
}

export function getStaticPaths() {
    const apiDataset = dataset as ApiReferenceDataset;
    const modulesByPackage = new Map<string, ApiReferenceRecord[]>();
    for (const record of apiDataset.records) {
        const modules = modulesByPackage.get(record.packageId) ?? [];
        modules.push(record);
        modulesByPackage.set(record.packageId, modules);
    }
    const packagePages = [ ...modulesByPackage.entries() ].flatMap(([ packageId, packageModules ]) => {
        const record = packageModules[0];
        return record === undefined ? [] : [{
            params: { slug: packageId },
            props: { record, packageModules, view: packageModules.length === 1 ? "module" as const : "package" as const }
        }];
    });
    const modulePages = apiDataset.records.filter((record) => modulesByPackage.get(record.packageId)?.length !== 1).map((record) => {
        const modulePath = record.module === record.packageId
            ? "Core"
            : record.module.startsWith(`${record.packageId}/`)
                ? record.module.slice(record.packageId.length + 1)
                : record.module;
        const packageModules = apiDataset.records.filter((moduleRecord) => moduleRecord.packageId === record.packageId);
        return { params: { slug: `${record.packageId}/${modulePath}` }, props: { record, packageModules, view: "module" as const } };
    });
    return [ ...packagePages, ...modulePages ];
}

const { record, packageModules = [], view } = Astro.props as ApiPageProps;
---

{view === "package" ? <ApiPackageLayout record={record} /> : <ApiReferenceLayout record={record} packageModules={packageModules} />}
