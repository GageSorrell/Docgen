---
import type { ApiReferenceDataset } from "@sorrell/docs-api-reference";
import dataset from "../../data/ApiReference.json";
import DocsLayout from "../../layouts/DocsLayout.astro";

const apiDataset = dataset as ApiReferenceDataset;
const packages = [ ...new Map(apiDataset.records.map((record) => [record.packageId, record])).values()];
const docsPrefix = import.meta.env.BASE_URL.replace(/\/$/u, "");
const pages = packages.map((record) => ({ description: record.packageDescription ?? "", group: "API Reference", id: record.packageId, slug: `api/${record.packageId}`, title: record.packageName }));
---

<DocsLayout
    canonicalPath={`${docsPrefix}/api`}
    copyText={`# API Reference\n\n${packages.map((record) => [record.packageName, record.packageDescription].filter(Boolean).join("\n")).join("\n\n")}`}
    description="Browse package API references."
    headings={[]}
    pages={pages}
    slug="api"
    title="API Reference"
>
    <h1>API Reference</h1>
    <p>Browse generated API reference pages for documented packages.</p>
    <div class="docs-api-package-grid">
        {packages.map((record) => <a class="docs-api-package-card" href={`${docsPrefix}/api/${record.packageId}`}>
            <h2>{record.packageName}</h2>
            {record.packageDescription === undefined ? null : <p>{record.packageDescription}</p>}
        </a>)}
    </div>
</DocsLayout>

<style is:global>
    .docs-api-package-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); margin-top: 28px; }
    .docs-api-package-card { background: var(--docs-card-background); border: 1px solid var(--docs-border); border-radius: 10px; color: var(--docs-foreground); padding: 18px; text-decoration: none; }
    .docs-api-package-card:hover { border-color: var(--docs-accent); }
    .docs-api-package-card h2 { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1rem; margin: 0 0 8px; }
    .docs-api-package-card p { color: var(--docs-muted); margin: 0; }
</style>
