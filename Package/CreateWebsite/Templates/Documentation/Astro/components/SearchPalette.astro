---
import "@pagefind/default-ui/css/ui.css";
---

<button
    type="button"
    class="site-search-trigger"
    aria-label="Search"
    aria-keyshortcuts="Control+K Meta+K"
    data-search-open
>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
    <kbd aria-hidden="true"><span>Ctrl</span><span class="search-shortcut-plus">+</span><span>K</span></kbd>
</button>

<dialog class="docs-search-dialog" aria-labelledby="docs-search-title">
    <section class="docs-search-panel">
        <header class="docs-search-heading">
            <h2 id="docs-search-title">Search documentation</h2>
            <button type="button" class="docs-search-close" data-search-close aria-label="Close search">Esc</button>
        </header>
        <div id="docs-pagefind-search" aria-label="Search documentation"></div>
    </section>
</dialog>

<script>
    import { PagefindUI } from "@pagefind/default-ui";

    const dialog = document.querySelector<HTMLDialogElement>(".docs-search-dialog");
    let pagefind: PagefindUI | undefined;

    // The header actions are hidden at mobile widths; keep the dialog in the
    // top-level document so it can still open from the mobile menu trigger.
    if (dialog !== null && dialog.parentElement !== document.body) {
        document.body.append(dialog);
    }

    const openSearch = () => {
        if (dialog === null) return;
        if (!pagefind) {
            pagefind = new PagefindUI({
                bundlePath: "{{DOCS_PREFIX}}/pagefind/",
                element: "#docs-pagefind-search",
                showImages: false
            });
        }
        if (!dialog.open) dialog.showModal();
        window.setTimeout(() => dialog.querySelector<HTMLInputElement>("input")?.focus(), 0);
    };

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-search-open]")) {
            openSearch();
        } else if (target.closest("[data-search-close]")) {
            dialog?.close();
        } else if (target === dialog) {
            dialog.close();
        }
    });

    document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            openSearch();
        }
    });
</script>

<style is:global>
    .site-search-trigger {
        appearance: none;
        align-items: center;
        background: transparent;
        border: 1px solid color-mix(in srgb, var(--docs-border) 92%, var(--docs-foreground) 8%);
        border-radius: .375rem;
        color: var(--docs-muted);
        cursor: pointer;
        display: inline-flex;
        font: inherit;
        font-size: .875rem;
        gap: .5rem;
        height: 2rem;
        line-height: 1.5;
        padding: .25rem .625rem;
        transition: background-color .15s, border-color .15s, color .15s;
        white-space: nowrap;
    }
    .site-search-trigger:hover, .site-search-trigger:focus-visible {
        background: var(--docs-code-background);
        border-color: var(--docs-muted);
        color: var(--docs-foreground);
    }
    .site-search-trigger kbd {
        align-items: center;
        color: var(--docs-muted);
        display: inline-flex;
        font: inherit;
        font-size: 12px;
        gap: .125rem;
        line-height: 1;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
    }
    .site-search-trigger .search-shortcut-plus { color: var(--docs-border); font-size: .85em; }
    .landing-mobile-menu .site-search-trigger { justify-content: flex-start; width: 100%; }
    .docs-search-dialog {
        background: var(--docs-card-background);
        border: 1px solid var(--docs-border);
        border-radius: .8rem;
        box-shadow: 0 24px 80px color-mix(in oklch, var(--docs-foreground) 22%, transparent);
        color: var(--docs-foreground);
        margin: 10vh auto auto;
        max-height: 80vh;
        max-width: min(42rem, calc(100vw - 2rem));
        overflow: auto;
        padding: 0;
        width: 100%;
    }
    .docs-search-dialog::backdrop { background: color-mix(in oklch, var(--docs-foreground) 48%, transparent); backdrop-filter: blur(5px); }
    .docs-search-panel { padding: 1.1rem 1.25rem 1.25rem; }
    .docs-search-heading { align-items: center; border-bottom: 1px solid var(--docs-border); display: flex; justify-content: space-between; margin-bottom: 1rem; padding-bottom: .8rem; }
    .docs-search-heading h2 { color: var(--docs-foreground); font-size: 1rem; font-weight: 600; letter-spacing: -.025em; margin: 0; }
    .docs-search-close { background: var(--docs-background); border: 1px solid var(--docs-border); border-radius: .4rem; color: var(--docs-muted); cursor: pointer; font: inherit; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .7rem; line-height: 1; padding: .4rem .5rem; transition: border-color .15s, color .15s; }
    .docs-search-close:hover, .docs-search-close:focus-visible { border-color: var(--docs-accent); color: var(--docs-foreground); }
    .docs-search-dialog .pagefind-ui {
        --pagefind-ui-primary: var(--docs-accent);
        --pagefind-ui-text: var(--docs-foreground);
        --pagefind-ui-background: var(--docs-background);
        --pagefind-ui-border: var(--docs-border);
        --pagefind-ui-tag: var(--docs-code-background);
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: .5rem;
        --pagefind-ui-font: inherit;
    }
    .docs-search-dialog .pagefind-ui .pagefind-ui__form::before { background-color: var(--docs-muted); }
    .docs-search-dialog .pagefind-ui .pagefind-ui__search-input {
        appearance: none;
        background: var(--docs-background);
        border: 1px solid var(--docs-border);
        border-radius: .5rem;
        box-shadow: none;
        color: var(--docs-foreground);
        font-size: 1rem;
        font-weight: 400;
        padding-inline: 3.375rem 4.375rem;
        transition: border-color .15s, box-shadow .15s;
    }
    .docs-search-dialog .pagefind-ui .pagefind-ui__search-input::placeholder { color: var(--docs-muted); opacity: .7; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__search-input:focus { border-color: var(--docs-accent); box-shadow: 0 0 0 3px color-mix(in oklch, var(--docs-accent) 18%, transparent); outline: none; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result { border-color: var(--docs-border); border-radius: .5rem; padding: .8rem .75rem; transition: background-color .15s; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result:hover { background: color-mix(in oklch, var(--docs-code-background) 75%, var(--docs-accent) 4%); }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result-title { font-size: 1rem; font-weight: 600; letter-spacing: -.015em; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result-link { color: var(--docs-foreground); }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result-link:hover { color: var(--docs-accent); }
    .docs-search-dialog .pagefind-ui .pagefind-ui__result-excerpt { color: var(--docs-muted); font-size: .875rem; line-height: 1.55; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__message { color: var(--docs-muted); font-size: .875rem; font-weight: 500; height: auto; padding-block: .8rem; }
    .docs-search-dialog .pagefind-ui mark { background: color-mix(in oklch, var(--docs-accent) 16%, transparent); border-radius: .15rem; color: var(--docs-foreground); }
    .docs-search-dialog .pagefind-ui .pagefind-ui__button { border-color: var(--docs-border); border-radius: .5rem; color: var(--docs-foreground); font-size: .875rem; font-weight: 500; }
    .docs-search-dialog .pagefind-ui .pagefind-ui__button:hover { background: var(--docs-code-background); border-color: var(--docs-accent); }
    @media (max-width: 700px) {
        .docs-search-dialog { margin: 5vh auto auto; max-height: 90vh; }
        .docs-search-panel { padding: .75rem; }
        .docs-search-heading { margin-bottom: .75rem; }
    }
</style>
