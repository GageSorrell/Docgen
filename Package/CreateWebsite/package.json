{
  "name": "@sorrell/docs-create-website",
  "homepage": "https://docgen.sorrell.sh",
  "version": "1.0.1",
  "description": "Generate and orchestrate three-package Sorrell documentation websites.",
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GageSorrell/Docgen/tree/Master#ReadMe",
    "directory": "Package/CreateWebsite"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/Docgen/issues"
  },
  "license": "MIT",
  "private": false,
  "type": "module",
  "files": ["Distribution", "Templates", "ReadMe.md"],
  "main": "./Distribution/index.js",
  "types": "./Distribution/index.d.ts",
  "exports": {
    ".": {
      "types": "./Distribution/index.d.ts",
      "import": "./Distribution/index.js"
    }
  },
  "bin": {
    "sorrell-docs": "./Distribution/bin.js"
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json",
    "clean": "node ../../Script/Release/CleanBuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@sorrell/docs-api-reference": "1.0.1",
    "@sorrell/docs-cli": "1.0.1",
    "@sorrell/docs-core": "1.0.1",
    "@sorrell/docs-mcp": "1.0.1",
    "@sorrell/docs-skills": "1.0.1",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "vitest": "5.0.1"
  }
}
