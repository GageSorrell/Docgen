{
    "$schema": "https://docgen.sorrell.sh/docs.config.schema.json",
    "metadata": {
        "name": "Sorrell Docgen",
        "title": "Sorrell Docgen Toolset",
        "description": "Build readable documentation sites with a shared content, theme, and publishing system.",
        "logo": {
            "type": "dicebear",
            "style": "pixelbot",
            "props": {
                "tags": [
                    "animation"
                ],
                "glowColor": [
                    "86EFAC"
                ],
                "seed": "Felix"
            }
        },
        "url": "https://docgen.sorrell.sh",
        "repository": {
            "url": "https://github.com/GageSorrell/Documentation/tree/Master#ReadMe",
            "branch": "Master",
            "directory": "Documentation"
        }
    },
    "footer": {
        "columns": [
            {
                "title": "Resources",
                "links": [
                    { "label": "Documentation", "href": "/docs/" },
                    { "label": "API reference", "href": "/docs/api/" },
                    { "label": "Storybook", "href": "/storybook/" }
                ]
            },
            {
                "title": "Guides",
                "links": [
                    { "label": "Overview", "href": "/docs/" },
                    { "label": "Architecture", "href": "/docs/architecture/" },
                    { "label": "Authoring", "href": "/docs/authoring/" },
                    { "label": "Release readiness", "href": "/docs/release-readiness/" }
                ]
            },
            {
                "title": "Developer tools",
                "links": [
                    { "label": "API reference", "href": "/docs/api/" },
                    { "label": "Storybook", "href": "/storybook/" }
                ]
            },
            {
                "title": "Community",
                "links": [
                    { "label": "GitHub repository", "href": "https://github.com/GageSorrell/Documentation" },
                    { "label": "npm packages", "href": "https://www.npmjs.com/org/sorrell" }
                ]
            }
        ],
        "message": "© {year} {name}",
        "links": [
            { "label": "GitHub", "href": "https://github.com/GageSorrell/Documentation", "icon": "github" },
            { "label": "Storybook", "href": "/storybook/" }
        ]
    },
    "routing": {
        "documentationPrefix": "/docs",
        "storybookPrefix": "/storybook"
    },
    "landing": {
        "title": "Sorrell Docgen Toolset",
        "description": "Build readable documentation sites with a shared content, theme, and publishing system.",
        "primaryAction": {
            "label": "Read the docs",
            "href": "/docs/"
        },
        "sections": [
            {
                "id": "docs",
                "title": "Documentation",
                "body": "Articles, API references, and durable guides for Sorrell products.",
                "href": "/docs/"
            },
            {
                "id": "components",
                "title": "Components",
                "body": "Explore the reusable landing-page components in Storybook.",
                "href": "/storybook/"
            },
            {
                "id": "source",
                "title": "Open source",
                "body": "Inspect the source, packages, and release workflow on GitHub.",
                "href": "https://github.com/GageSorrell/Documentation"
            }
        ]
    },
    "storybook": {
        "enabled": true,
        "directory": "Storybook",
        "stories": [
            "Stories/**/*.stories.tsx",
            "Stories/**/*.mdx"
        ]
    },
    "versions": [
        {
            "current": true,
            "directory": ".",
            "id": "current",
            "label": "v1.0.1 (Latest)",
            "order": 0,
            "version": "1.0.1"
        },
        {
            "directory": "v1",
            "id": "v1",
            "label": "v1",
            "order": 1,
            "version": "1"
        }
    ],
    "navigation": {
        "groups": [
            {
                "id": "guides",
                "label": "Guides",
                "items": [
                    {
                        "id": "overview",
                        "label": "Overview",
                        "href": "/docs/",
                        "kind": "page"
                    },
                    {
                        "id": "architecture",
                        "label": "Architecture",
                        "href": "/docs/architecture/",
                        "kind": "page"
                    },
                    {
                        "id": "authoring",
                        "label": "Authoring",
                        "href": "/docs/authoring/",
                        "kind": "page"
                    }
                ]
            },
            {
                "id": "reference",
                "label": "Reference",
                "items": [
                    {
                        "id": "api",
                        "label": "API Reference",
                        "href": "/docs/api/",
                        "kind": "page"
                    }
                ]
            }
        ]
    },
    "api": {
        "enabled": true,
        "entryPoints": [
            "Package/Core/Source/index.ts",
            "Package/Ui/Source/index.ts"
        ],
        "outputDirectory": "Documentation/Source/data",
        "packages": [
            "@sorrell/docs-core",
            "@sorrell/docs-ui"
        ],
        "sourceRepository": {
            "url": "https://github.com/GageSorrell/Documentation",
            "branch": "Master"
        },
        "typedoc": {}
    },
    "agent": {
        "enabled": true,
        "essentials": []
    },
    "vercel": {
        "enabled": true,
        "domains": [
            "docgen.sorrell.sh"
        ],
        "productionBranch": "Master",
        "projects": {
            "landing": {
                "project": "docgen-landing"
            },
            "documentation": {
                "project": "docgen"
            },
            "storybook": {
                "project": "docgen-storybook"
            }
        }
    }
}
