{
  "buildCommand": "npm run build",
  "headers": [
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/llms.txt"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/agent/:path*"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/docs/:path*.md"
    },
    {
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ],
      "source": "/storybook/agent/:path*"
    }
  ],
  "installCommand": "npm install",
  "outputDirectory": "Distribution",
  "redirects": [
    {
      "destination": "/storybook/",
      "source": "/storybook",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "destination": "https://storybook-snapshot.invalid/storybook",
      "source": "/storybook"
    },
    {
      "destination": "https://storybook-snapshot.invalid/storybook/:path*",
      "source": "/storybook/:path*"
    }
  ],
  "version": 2
}
