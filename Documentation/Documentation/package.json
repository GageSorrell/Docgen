{
  "name": "@sorrell/documentation",
  "version": "1.0.1",
  "private": true,
  "author": {
    "name": "Gage Sorrell",
    "email": "gage@sorrell.sh",
    "url": "https://sorrell.sh"
  },
  "homepage": "https://docs.sorrell.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/GageSorrell/Documentation/tree/Master#ReadMe",
    "directory": "Documentation/Documentation"
  },
  "bugs": {
    "url": "https://github.com/GageSorrell/Documentation/issues"
  },
  "type": "module",
  "description": "The published dogfood documentation site.",
  "scripts": {
    "api:generate": "node GenerateApi.mjs",
    "build": "npm run api:generate && astro build && pagefind --site dist --output-path dist/pagefind",
    "dev": "npm run api:generate && astro dev",
    "preview": "astro preview",
    "typecheck": "npm run api:generate && astro check",
    "verify": "npm run typecheck && astro build && pagefind --site dist --output-path dist/pagefind"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@pagefind/default-ui": "1.5.2",
    "@sorrell/docs-api-reference": "1.0.1",
    "@sorrell/docs-astro": "1.0.1",
    "@sorrell/docs-core": "1.0.1",
    "@sorrell/docs-ui": "1.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.4",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@sorrell/tsconfig": "2.1.0",
    "pagefind": "1.5.2",
    "typescript": "6.0.2"
  }
}
