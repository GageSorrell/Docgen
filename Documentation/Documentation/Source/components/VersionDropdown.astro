---
/**
 * Header version selector for the versioned documentation routes.
 *
 * @module @sorrell/documentation/components/VersionDropdown
 * @file VersionDropdown.astro
 */
import { documentationVersions } from "../Versions.js";

interface Props
{
    readonly currentVersion: string;
    readonly slug?: string | undefined;
    readonly placement?: "header" | "mobile" | undefined;
}

const { currentVersion, slug = "", placement = "header" } = Astro.props;
const selectedVersion = documentationVersions.find((item) => item.id === currentVersion)
    ?? documentationVersions[0]
    ?? { id: "current", label: "Latest", version: "1" };
const versionNumber = (version: string): string => `v${version}`;
const versionHref = (versionId: string): string =>
    versionId === "current"
        ? `/docs/${slug}`
        : `/docs/${versionId}/${slug}`;
---

<details class:list={["docs-version-dropdown", `docs-version-dropdown-${placement}`]}>
    <summary aria-label={`Documentation version: ${selectedVersion.label}`}>
        <span class="docs-version-label">
            <span class="docs-version-number">{versionNumber(selectedVersion.version)}</span>
            {selectedVersion.id === "current" && <span class="docs-version-latest">(Latest)</span>}
        </span>
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m7 10 5 5 5-5" /></svg>
    </summary>
    <nav aria-label="Documentation versions">
        {documentationVersions.map((item) => <a
            aria-current={currentVersion === item.id ? "page" : undefined}
            href={versionHref(item.id)}
        >
            <span class="docs-version-label">
                <span class="docs-version-number">{item.id === "current" ? versionNumber(item.version) : item.label}</span>
                {item.id === "current" && <span class="docs-version-latest">(Latest)</span>}
            </span>
            {currentVersion === item.id && <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>}
        </a>)}
    </nav>
</details>

<script is:inline>
    (() => {
        if (window.__sorrellVersionDropdownInitialized) return;
        window.__sorrellVersionDropdownInitialized = true;
        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            document.querySelectorAll(".docs-version-dropdown[open]").forEach((dropdown) => {
                if (!dropdown.contains(target)) dropdown.removeAttribute("open");
            });
        });
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            const dropdown = document.querySelector(".docs-version-dropdown[open]");
            if (!dropdown) return;
            dropdown.removeAttribute("open");
            dropdown.querySelector("summary")?.focus();
        });
    })();
</script>

<style is:global>
    .docs-version-dropdown { position: relative; color: var(--docs-foreground); font-size: .875rem; }
    .docs-version-dropdown > summary { display: inline-flex; min-height: 2rem; align-items: center; justify-content: space-between; gap: .55rem; border: 1px solid color-mix(in srgb, var(--docs-border) 92%, var(--docs-foreground) 8%); border-radius: .4rem; padding: .25rem .6rem; background: transparent; color: var(--docs-muted); cursor: pointer; list-style: none; transition: border-color .15s, background-color .15s, color .15s; }
    .docs-version-label { display: inline-flex; align-items: baseline; gap: .25rem; white-space: nowrap; }
    .docs-version-number { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .docs-version-latest { font-family: inherit; font-size: .75em; white-space: nowrap; }
    .docs-version-dropdown > summary::-webkit-details-marker { display: none; }
    .docs-version-dropdown > summary:hover, .docs-version-dropdown > summary:focus-visible, .docs-version-dropdown[open] > summary { border-color: var(--docs-muted); background: var(--docs-code-background); color: var(--docs-foreground); outline: none; }
    .docs-version-dropdown > summary svg { transition: transform .15s; }
    .docs-version-dropdown[open] > summary svg { transform: rotate(180deg); }
    .docs-version-dropdown nav { position: absolute; top: calc(100% + .45rem); right: 0; z-index: 60; display: grid; width: max-content; min-width: 9rem; max-width: calc(100vw - 2rem); gap: .15rem; padding: .35rem; border: 1px solid var(--docs-border); border-radius: .55rem; background: var(--docs-background); box-shadow: 0 .75rem 1.75rem color-mix(in oklch, var(--docs-foreground) 14%, transparent); }
    .docs-version-dropdown nav a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; border-radius: .35rem; padding: .5rem .6rem; color: var(--docs-muted); text-decoration: none; }
    .docs-version-dropdown nav a:hover, .docs-version-dropdown nav a:focus-visible, .docs-version-dropdown nav a[aria-current="page"] { background: var(--docs-code-background); color: var(--docs-foreground); outline: none; }
    .docs-version-dropdown-mobile { padding-top: .45rem; border-top: 1px solid var(--docs-border); }
    .docs-version-dropdown-mobile > summary { width: 100%; }
    .docs-version-dropdown-mobile nav { position: static; margin-top: .35rem; box-shadow: none; }
    @media (max-width: 800px) { .docs-version-dropdown-header { display: none; } }
</style>
