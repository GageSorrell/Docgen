---
/**
 * Shared documentation header aligned with the public Landing header.
 *
 * @module @sorrell/documentation/components/SiteHeader
 * @file SiteHeader.astro
 */
import SearchPalette from "./SearchPalette.astro";
import SiteThemeToggle from "./SiteThemeToggle.astro";
import VersionDropdown from "./VersionDropdown.astro";
import siteConfig from "../../../docs.config.json";

interface Props
{
    readonly currentVersion?: string | undefined;
    readonly slug?: string | undefined;
}

const { currentVersion, slug = "" } = Astro.props;
const repositoryUrl = siteConfig.metadata.repository?.url;
const navigation = [
    { label: "Docs", href: "/docs/" },
    { label: "Architecture", href: "/docs/architecture/" },
    { label: "Authoring", href: "/docs/authoring/" },
    { label: "API", href: "/docs/api/" },
    { label: "Storybook", href: "/storybook/" }
];
---

<header class="landing-header">
    <div class="landing-container landing-header-inner">
        <a href="/" class="landing-brand" aria-label="sorrell-documentation home">
            <span>sorrell-documentation</span>
        </a>
        <nav class="landing-header-nav" aria-label="Primary navigation">
            {navigation.map((item) => <a
                href={item.href}
                {...item.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
            >{item.label}</a>)}
        </nav>
        <div class="landing-header-actions">
            {currentVersion === undefined ? null : <VersionDropdown currentVersion={currentVersion} slug={slug} />}
            <SearchPalette />
            {repositoryUrl ? <>
                <span class="landing-header-divider" aria-hidden="true"></span>
                <a class="landing-header-social-link" href={repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.73 1.16 1.73 1.16 1 .1.8-1.34 2.97-1.8.1-.72.4-1.2.7-1.48-2.5-.29-5.13-1.25-5.13-5.58 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.99 0 0 .95-.3 3.1 1.16a10.8 10.8 0 0 1 5.64 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.56.23 2.7.11 2.99.72.79 1.16 1.8 1.16 3.03 0 4.34-2.63 5.29-5.14 5.57.4.35.75 1.03.75 2.08v3.09c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
                </a>
                <span class="landing-header-divider" aria-hidden="true"></span>
            </> : null}
            <SiteThemeToggle />
        </div>
        <details class="landing-mobile-menu">
            <summary aria-label="Open navigation"><span>Menu</span><span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
                <button class="site-search-trigger" type="button" aria-label="Search" aria-keyshortcuts="Control+K Meta+K" data-search-open>
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg>
                    <span>Search</span><kbd aria-hidden="true"><span>Ctrl</span><span class="search-shortcut-plus">+</span><span>K</span></kbd>
                </button>
                {navigation.map((item) => <a
                    href={item.href}
                    {...item.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
                >{item.label}</a>)}
                {repositoryUrl ? <a href={repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub</a> : null}
                {currentVersion === undefined ? null : <VersionDropdown currentVersion={currentVersion} slug={slug} placement="mobile" />}
                <div class="landing-mobile-theme">
                    <span>Theme</span>
                    <SiteThemeToggle />
                </div>
            </nav>
        </details>
    </div>
</header>

<script is:inline>
    (() => {
        const themeKey = "sorrell-docs-theme";
        const themeModes = ["system", "light", "dark"];
        const systemPreference = window.matchMedia("(prefers-color-scheme: dark)");
        const readThemeMode = () => {
            try {
                const stored = localStorage.getItem(themeKey);
                if (themeModes.includes(stored)) return stored;
            } catch { /* Storage can be unavailable in restricted contexts. */ }
            return "system";
        };
        let selectedMode = readThemeMode();
        const updateThemeToggles = () => {
            const nextMode = themeModes[(themeModes.indexOf(selectedMode) + 1) % themeModes.length];
            const modeLabel = selectedMode[0].toUpperCase() + selectedMode.slice(1);
            document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
                button.setAttribute("aria-label", `Theme: ${modeLabel}. Activate to switch to ${nextMode}.`);
                button.setAttribute("title", `Theme: ${modeLabel}`);
                button.dataset.themeMode = selectedMode;
                button.querySelectorAll("[data-theme-icon]").forEach((icon) => {
                    icon.classList.toggle("hidden", icon.dataset.themeIcon !== selectedMode);
                });
            });
        };
        const applyTheme = (mode, persist = false) => {
            selectedMode = mode;
            const dark = mode === "dark" || (mode === "system" && systemPreference.matches);
            document.documentElement.dataset.theme = dark ? "dark" : "light";
            document.documentElement.classList.toggle("dark", dark);
            document.documentElement.style.colorScheme = dark ? "dark" : "light";
            if (persist) {
                try { localStorage.setItem(themeKey, mode); } catch { /* Storage can be unavailable in restricted contexts. */ }
            }
            updateThemeToggles();
        };
        applyTheme(selectedMode);
        document.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element) || target.closest("[data-theme-toggle]") === null) return;
            const nextMode = themeModes[(themeModes.indexOf(selectedMode) + 1) % themeModes.length];
            applyTheme(nextMode, true);
        });
        systemPreference.addEventListener("change", () => { if (selectedMode === "system") applyTheme("system"); });
        window.addEventListener("storage", (event) => {
            if (event.key !== themeKey) return;
            applyTheme(themeModes.includes(event.newValue) ? event.newValue : "system");
        });
    })();
</script>

<style is:global>
    .landing-container { width: min(100% - 2rem, 72rem); margin-inline: auto; }
    .landing-header { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--docs-border); background: color-mix(in oklch, var(--docs-background) 92%, transparent); backdrop-filter: blur(14px); }
    .landing-header-inner { display: flex; min-height: 4rem; align-items: center; gap: 2rem; }
    .landing-brand { display: inline-flex; align-items: center; flex: 0 0 auto; }
    .landing-header-nav { display: flex; align-items: center; gap: 1.35rem; font-size: .875rem; color: var(--docs-muted); }
    .landing-header-nav a:hover, .landing-header-nav a:focus-visible { color: var(--docs-foreground); }
    .landing-header-actions { margin-left: auto; display: flex; align-items: center; gap: .5rem; }
    .landing-header-divider { width: 1px; height: 1.5rem; background: var(--docs-border); opacity: .75; }
    .landing-header-social-link { display: inline-flex; width: 2.25rem; height: 2.25rem; align-items: center; justify-content: center; border-radius: .375rem; color: var(--docs-muted); text-decoration: none; transition: color .15s ease, background-color .15s ease; }
    .landing-header-social-link:hover, .landing-header-social-link:focus-visible { background: var(--docs-code-background); color: var(--docs-foreground); }
    .landing-header-actions .site-search-trigger { background: transparent; border: 1px solid color-mix(in srgb, var(--docs-border) 92%, var(--docs-foreground) 8%); color: var(--docs-muted); height: 2rem; padding: .25rem .625rem; width: auto; }
    .landing-header-actions .site-search-trigger:hover, .landing-header-actions .site-search-trigger:focus-visible { background: var(--docs-code-background); border-color: var(--docs-muted); color: var(--docs-foreground); }
    .site-theme-toggle { display: inline-flex; height: 2.25rem; width: 2.25rem; align-items: center; justify-content: center; border-width: 0; border-style: solid; border-color: var(--docs-foreground); border-radius: .375rem; background: transparent; color: var(--docs-foreground); cursor: pointer; transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke; transition-duration: .15s; transition-timing-function: cubic-bezier(.4, 0, .2, 1); }
    .site-theme-toggle:hover { background: var(--docs-code-background); }
    .landing-mobile-menu { display: none; margin-left: auto; position: relative; }
    .landing-mobile-menu summary { display: flex; align-items: center; gap: .5rem; cursor: pointer; list-style: none; border: 1px solid var(--docs-border); border-radius: .45rem; padding: .5rem .7rem; font-size: .875rem; color: var(--docs-foreground); }
    .landing-mobile-menu summary::-webkit-details-marker { display: none; }
    .landing-mobile-menu nav { position: absolute; right: 0; top: 3rem; display: grid; min-width: 12rem; gap: .25rem; padding: .5rem; border: 1px solid var(--docs-border); border-radius: .65rem; background: var(--docs-background); box-shadow: 0 1rem 2rem color-mix(in oklch, var(--docs-foreground) 14%, transparent); }
    .landing-mobile-menu nav a { border-radius: .4rem; padding: .65rem .75rem; color: var(--docs-foreground); }
    .landing-mobile-menu nav a:hover, .landing-mobile-menu nav a:focus-visible { background: var(--docs-code-background); }
    .landing-mobile-theme { display: flex; align-items: center; justify-content: space-between; margin-top: .35rem; border-top: 1px solid var(--docs-border); padding: .4rem .25rem 0 .75rem; color: var(--docs-muted); font-size: .875rem; }
    .landing-mobile-theme .site-theme-toggle { margin: -.3rem; }
    .hidden { display: none; }
    @media (max-width: 800px) {
        .landing-header-nav, .landing-header-actions { display: none; }
        .landing-mobile-menu { display: block; }
    }
    @media (max-width: 560px) {
        .landing-container { width: min(100% - 1.25rem, 72rem); }
    }
</style>
