---
import type { ApiReferenceRecord } from "@sorrell/docs-core";
import { DefaultDesignTokens } from "@sorrell/docs-core";
import { canonicalUrl } from "@sorrell/docs-astro";
import { createThemeCss, docsUiCss } from "@sorrell/docs-ui";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import siteConfig from "../../../docs.config.json";
import "../styles/docs.css";

interface Props { readonly record: ApiReferenceRecord; }
const { record } = Astro.props as Props;
const canonicalPath = Astro.url.pathname;
const canonical = canonicalUrl(Astro.site?.toString() ?? "https://docs.sorrell.sh", canonicalPath);
const siteUrl = siteConfig.metadata.url ?? "";
const docsPrefix = siteConfig.routing?.documentationPrefix ?? "/docs";
const docsImagePath = `/${[ ...docsPrefix.split("/").filter(Boolean), "opengraph.svg" ].join("/")}`;
const ogImageUrl = siteUrl === "" ? undefined : new URL(docsImagePath, siteUrl).toString();
const packageHref = record.breadcrumbs.find((breadcrumb) => breadcrumb.label === record.packageName)?.href ?? `/docs/api/${record.packageId}`;
const packageSourceUrl = record.packageSourceUrl ?? record.source?.repositoryUrl;
const modules = (record.packageExports ?? [ "." ]).map((exportPath) => {
    const path = exportPath === "." ? "" : exportPath.replace(/^\.\//u, "");
    const parts = path.split("/").filter(Boolean);
    const firstPart = parts[0];
    return {
        exportPath,
        group: firstPart === undefined ? "Core" : `${firstPart[0]?.toUpperCase() ?? ""}${firstPart.slice(1)}`,
        href: `${packageHref}/${exportPath === "." ? "Core" : path}`,
        label: parts.at(-1) ?? "Core"
    };
});
const groups = [ ...new Set([ "Core", ...modules.map((module) => module.group) ]) ];
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        {record.packageDescription === undefined ? null : <meta name="description" content={record.packageDescription} />}
        <meta property="og:title" content={`${record.packageName} · API Reference`} />
        {ogImageUrl ? <><meta property="og:image" content={ogImageUrl} /><meta property="og:image:type" content="image/svg+xml" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></> : null}
        {record.packageDescription === undefined ? null : <meta property="og:description" content={record.packageDescription} />}
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/png" href="/docs/favicon.png" data-theme-favicon="light" media="all" />
        <link rel="icon" type="image/png" href="/docs/favicon.png" data-theme-favicon="dark" media="not all" />
        <title>{record.packageName} · API Reference</title>
    </head>
    <body>
        <div class="docs-site docs-api-package-site">
            <SiteHeader />
            <main class="docs-api-package-main" id="main-content">
                <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
                    {record.breadcrumbs.slice(0, 3).map((breadcrumb, index) => <>
                        {index === 0 ? null : <span class="docs-breadcrumb-separator" aria-hidden="true">{" / "}</span>}
                        {breadcrumb.href === undefined ? <span>{breadcrumb.label}</span> : <a href={breadcrumb.href}>{breadcrumb.label}</a>}
                    </>)}
                </nav>
                <p class="docs-eyebrow">API REFERENCE</p>
                <h1>{record.packageName}</h1>
                {record.packageDescription === undefined ? null : <p class="docs-api-package-description">{record.packageDescription}</p>}
                <div class="docs-api-package-meta">
                    <span>{modules.length} {modules.length === 1 ? "module" : "modules"}</span>
                    {record.packagePrivate === true ? null : <a class="docs-package-link" href={`https://www.npmjs.com/package/${record.packageName}`} rel="noreferrer">
                        <svg aria-hidden="true" class="docs-npm-logo" viewBox="0 0 640 640" fill="currentColor"><path fill="currentColor" d="M320 352h-32v-64h32zm288-128v192H320v32H192v-32H32V224zm-416 32H64v128h64v-96h32v96h32zm160 0H224v160h64v-32h64zm160 0H384v128h64v-96h32v96h32v-96h32v96h32z" /></svg>
                        npm
                    </a>}
                    {packageSourceUrl === undefined ? null : <a class="docs-source-link" href={packageSourceUrl} rel="noreferrer">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.07c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.11.08 1.7 1.14 1.7 1.14 1 1.69 2.59 1.2 3.22.92.1-.72.39-1.2.7-1.48-2.46-.28-5.04-1.23-5.04-5.47 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.4.1-2.93 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.54 0c2.12-1.44 3.04-1.14 3.04-1.14.61 1.53.23 2.65.11 2.93.71.77 1.14 1.76 1.14 2.97 0 4.25-2.59 5.19-5.06 5.46.4.34.75 1.02.75 2.05v3.05c0 .3.2.64.76.53A11.1 11.1 0 0 0 12 .9Z" /></svg>
                        Source
                    </a>}
                </div>
                <label class="docs-api-package-search-label" for="docs-package-module-search">Search {record.packageName} modules</label>
                <input class="docs-api-package-search" id="docs-package-module-search" type="search" placeholder={`Search ${record.packageName} modules…`} />
                <div data-package-module-results>
                    {groups.map((group) => <section class="docs-api-module-group" data-module-group={group}>
                        <h2>{group}</h2>
                        <div class="docs-api-module-grid">
                            {modules.filter((module) => module.group === group).map((module) => <a class="docs-api-module-card" data-module-search={`${module.group} ${module.label} ${module.exportPath}`.toLowerCase()} href={module.href}>
                                <span>{module.label}</span><span aria-hidden="true">↗</span>
                            </a>)}
                        </div>
                    </section>)}
                    <p class="docs-api-module-empty" data-module-no-results hidden>No modules match your search.</p>
                </div>
            </main>
            <Footer />
        </div>
    </body>
</html>

<style is:global set:html={docsUiCss}></style>
<style is:global set:html={createThemeCss(DefaultDesignTokens)}></style>
<style is:global>
    :root { color-scheme: dark; }
    [data-theme="light"] { color-scheme: light; }
    body { margin: 0; }
    .docs-api-package-site { min-height: 100vh; }
    .docs-api-package-main { margin: 0 auto; max-width: 1120px; min-height: calc(100vh - var(--docs-header-height, 68px)); padding: 40px clamp(20px, 5vw, 72px) 80px; }
    .docs-api-package-main > .docs-breadcrumbs { display: flex; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.2px; font-weight: 400; gap: 0; margin: 0 0 54px; }
    .docs-api-package-main .docs-breadcrumb-separator { margin-right: 0; white-space: pre; }
    .docs-api-package-main > .docs-eyebrow { color: var(--docs-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.2px; letter-spacing: .14em; margin: 0 0 16px; }
    .docs-api-package-main h1 { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(34px, 5vw, 58px); font-weight: 700; letter-spacing: -.05em; line-height: 1.1; margin: 0; overflow-wrap: anywhere; }
    .docs-api-package-description { color: var(--docs-prose-foreground); font-size: clamp(17px, 2vw, 21px); line-height: 1.6; margin: 22px 0 0; max-width: 780px; }
    .docs-api-package-meta { align-items: center; color: var(--docs-muted); display: flex; flex-wrap: wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; gap: 24px; margin: 28px 0 28px; }
    .docs-api-package-meta a { color: var(--docs-muted); }
    .docs-api-package-meta a:hover { color: var(--docs-foreground); }
    .docs-package-link, .docs-source-link { align-items: center; display: inline-flex; gap: 7px; text-decoration: none; }
    .docs-npm-logo { flex: none; height: 16px; width: 16px; }
    .docs-source-link svg { flex: none; height: 16px; width: 16px; }
    .docs-api-package-search-label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
    .docs-api-package-search { background: var(--docs-card-background); border: 1px solid var(--docs-border); border-radius: 9px; box-sizing: border-box; color: var(--docs-foreground); font: inherit; margin-bottom: 30px; max-width: 100%; padding: 13px 15px; width: min(100%, 620px); }
    .docs-api-package-search:focus-visible { border-color: var(--docs-accent); outline: 2px solid color-mix(in srgb, var(--docs-accent) 30%, transparent); outline-offset: 2px; }
    .docs-api-module-group { margin: 0 0 38px; }
    .docs-api-module-group h2 { font-size: 22px; letter-spacing: -.025em; margin: 0 0 14px; }
    .docs-api-module-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
    .docs-api-module-card { align-items: center; background: var(--docs-card-background); border: 1px solid var(--docs-border); border-radius: 10px; color: var(--docs-foreground); display: flex; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; gap: 12px; justify-content: space-between; min-width: 0; padding: 12px 16px; text-decoration: none; transition: border-color 120ms ease, background 120ms ease; }
    .docs-api-module-card:hover, .docs-api-module-card:focus-visible { background: var(--docs-code-background); border-color: var(--docs-accent); }
    .docs-api-module-card span:first-child { overflow-wrap: anywhere; }
    .docs-api-module-card span:last-child { color: var(--docs-muted); flex: none; }
    .docs-api-module-empty { color: var(--docs-muted); }
    @media (max-width: 600px) { .docs-api-package-main > .docs-breadcrumbs { margin-bottom: 36px; } .docs-api-package-meta { gap: 16px; } }
</style>

<script is:inline>
    const moduleSearch = document.querySelector("#docs-package-module-search");
    if (moduleSearch) {
        moduleSearch.addEventListener("input", () => {
            const query = moduleSearch.value.trim().toLocaleLowerCase();
            let visibleCount = 0;
            document.querySelectorAll("[data-module-group]").forEach((group) => {
                let groupCount = 0;
                group.querySelectorAll("[data-module-search]").forEach((card) => {
                    const visible = card.dataset.moduleSearch.includes(query);
                    card.hidden = !visible;
                    if (visible) { groupCount += 1; visibleCount += 1; }
                });
                group.hidden = groupCount === 0;
            });
            const empty = document.querySelector("[data-module-no-results]");
            if (empty) empty.hidden = visibleCount !== 0;
        });
    }
</script>
