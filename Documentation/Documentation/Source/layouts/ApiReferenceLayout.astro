---
import type { ApiReferenceRecord } from "@sorrell/docs-core";
import { recordToAgentDocument } from "@sorrell/docs-api-reference";
import { DefaultDesignTokens, formatAgentDocument } from "@sorrell/docs-core";
import { canonicalUrl } from "@sorrell/docs-astro";
import { createThemeCss, docsUiCss } from "@sorrell/docs-ui";
import { createHighlighter } from "shiki";
import ApiReferenceDescription from "../components/ApiReferenceDescription.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { SiteLogo } from "../lib/dicebear.js";
import siteConfig from "../../../docs.config.json";
import "../styles/docs.css";

interface Props
{
    readonly record: ApiReferenceRecord;
    readonly packageModules: readonly ApiReferenceRecord[];
}

const { record, packageModules } = Astro.props as Props;
const document = recordToAgentDocument(record);
const copyText = formatAgentDocument({ ...document, url: new URL(Astro.url.pathname, "https://docs.sorrell.sh").toString() });
const canonicalPath = Astro.url.pathname;
const canonical = canonicalUrl(Astro.site?.toString() ?? "https://docs.sorrell.sh", canonicalPath);
const configuredLogo = (siteConfig.metadata as typeof siteConfig.metadata & { readonly logo?: SiteLogo }).logo;
const hasDicebearLogo = typeof configuredLogo === "object" && configuredLogo?.type === "dicebear";
const sourceHref = (source: ApiReferenceRecord["source"]): string | undefined => source === undefined ? undefined : `${source.repositoryUrl}/blob/${source.revision}/${source.file}${source.line === undefined ? "" : `#L${source.line}`}`;
const declarationsFor = (categoryId: string) => record.declarations.filter((declaration) => declaration.categoryId === categoryId);
const uncategorizedDeclarations = record.declarations
    .filter((declaration) => declaration.category === undefined || declaration.category.trim() === "")
    .sort((left, right) => left.name.localeCompare(right.name));
const declarationCategoryNames = [ ...new Set(record.declarations
    .map((declaration) => declaration.category?.trim())
    .filter((category): category is string => category !== undefined && category !== ""))]
    .sort((left, right) => left.localeCompare(right, undefined, { sensitivity: "base" }));
const declarationsInCategory = (category: string) => record.declarations
    .filter((declaration) => declaration.category?.trim() === category)
    .sort((left, right) => left.name.localeCompare(right.name));
const moduleNavigation = packageModules.map((moduleRecord) => {
    const modulePath = moduleRecord.module === moduleRecord.packageId
        ? ""
        : moduleRecord.module.startsWith(`${moduleRecord.packageId}/`)
            ? moduleRecord.module.slice(moduleRecord.packageId.length + 1)
            : moduleRecord.module;
    const parts = modulePath.split("/").filter(Boolean);
    const groupPart = parts[0];
    const group = groupPart === undefined ? "Core" : `${groupPart[0]?.toUpperCase() ?? ""}${groupPart.slice(1)}`;
    return {
        group,
        href: moduleRecord.link?.href ?? `/docs/api/${moduleRecord.packageId}/${modulePath || "Core"}`,
        label: parts.at(-1) ?? "Core",
        module: moduleRecord.module
    };
}).sort((left, right) => left.group === right.group
    ? left.label.localeCompare(right.label)
    : left.group === "Core" ? -1 : right.group === "Core" ? 1 : left.group.localeCompare(right.group));
const moduleGroups = [ ...new Set([ "Core", ...moduleNavigation.map((module) => module.group) ]) ];
const highlighter = await createHighlighter({
    langs: ["typescript", "javascript", "bash", "json"],
    themes: ["github-light", "github-dark"]
});
const signatures = new Map(record.declarations.map((declaration) => [
    declaration.id,
    highlighter.codeToHtml(declaration.signature, {
        lang: "typescript",
        themes: { dark: "github-dark", light: "github-light" },
        defaultColor: false
    })
]));
const exampleHtml = new Map<string, string>();
for (const declaration of record.declarations)
{
    declaration.examples?.forEach((example, index) =>
    {
        const supportedLanguages = ["typescript", "javascript", "bash", "json"];
        const language = supportedLanguages.includes(example.language ?? "")
            ? example.language!
            : "typescript";
        exampleHtml.set(
            `${declaration.id}:${index}`,
            highlighter.codeToHtml(example.code, {
                lang: language,
                themes: { dark: "github-dark", light: "github-light" },
                defaultColor: false
            })
        );
    });
}
highlighter.dispose();
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        {record.summary === undefined ? null : <meta name="description" content={record.summary} />}
        {record.summary === undefined ? null : <meta property="og:description" content={record.summary} />}
        <meta property="og:title" content={`${record.displayName} · API Reference`} />
        <link rel="canonical" href={canonical} />
        {hasDicebearLogo ? <><link rel="icon" href="/docs/favicon-light.svg" data-theme-favicon="light" media="all" /><link rel="icon" href="/docs/favicon-dark.svg" data-theme-favicon="dark" media="not all" /></> : null}
        <link rel="alternate" type="text/markdown" href={`${canonicalPath}.md`} />
        <title>{record.displayName} · API Reference</title>
    </head>
    <body>
        <div class="docs-site docs-api-site">
            <SiteHeader />
            <div class="docs-api-page">
                <aside class="docs-sidebar" aria-label="API reference navigation">
                    <div class="docs-sidebar-label">API REFERENCE</div>
                    <h2 class="docs-api-package">{record.packageName}</h2>
                    <p class="docs-api-version">{record.version}</p>
                    {packageModules.length > 1 ? moduleGroups.map((group) => <section class="docs-sidebar-group">
                        <h3>{group}<span aria-hidden="true">⌃</span></h3>
                        <ul class="docs-nav-items">
                            {moduleNavigation.filter((module) => module.group === group).map((module) => <li><a href={module.href} class={module.module === record.module ? "is-active" : undefined} aria-current={module.module === record.module ? "page" : undefined}>{module.label}</a></li>)}
                        </ul>
                    </section>) : null}
                </aside>
                <main class="docs-api-main" id="main-content">
                    <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
                        {record.breadcrumbs.map((breadcrumb, index) => <>
                            {index === 0 ? null : <span class="docs-breadcrumb-separator">/</span>}
                            {breadcrumb.current || breadcrumb.href === undefined ? <span>{index === 1 && !/^[vV]/u.test(breadcrumb.label) ? `V${breadcrumb.label}` : breadcrumb.label}</span> : <a href={breadcrumb.href}>{index === 1 && !/^[vV]/u.test(breadcrumb.label) ? `V${breadcrumb.label}` : breadcrumb.label}</a>}
                        </>)}
                    </nav>
                    <div class="docs-api-heading-row">
                        <div>
                            <p class="docs-eyebrow">API REFERENCE</p>
                            <div class="docs-api-title-row">
                                <h1>{record.displayName}</h1>
                                <button class="docs-copy-button" type="button" aria-label="Copy for LLM" aria-live="polite" data-copied="false" data-copy-llm data-copy-text={copyText}>
                                    <span aria-hidden="true" class="docs-copy-button-icon">
                                        <svg class="docs-copy-icon" viewBox="0 0 24 24" fill="none"><rect x="8" y="8" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                                        <svg class="docs-copy-success-icon" viewBox="0 0 24 24" fill="none"><path d="m20 6-11 11-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </span>
                                    <span class="docs-copy-button-label"><span>Copy for LLM</span><span>Copied markdown!</span></span>
                                </button>
                            </div>
                            {record.summary === undefined ? null : <div class="prose prose-effect"><ApiReferenceDescription description={record.summary} parts={record.summaryParts} /></div>}
                        </div>
                    </div>
                    <div class="docs-api-meta">
                        <span>{record.exportCount} exports</span>
                        {record.introductionVersion === undefined ? null : <span>Added in v{record.introductionVersion}</span>}
                        {sourceHref(record.source) === undefined ? null : <a class="docs-source-link" href={sourceHref(record.source)} rel="noreferrer">
                            <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.07c-3.09.67-3.74-1.31-3.74-1.31-.5-1.28-1.23-1.62-1.23-1.62-1-.68.08-.67.08-.67 1.11.08 1.7 1.14 1.7 1.14 1 1.69 2.59 1.2 3.22.92.1-.72.39-1.2.7-1.48-2.46-.28-5.04-1.23-5.04-5.47 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.4.1-2.93 0 0 .93-.3 3.05 1.14a10.6 10.6 0 0 1 5.54 0c2.12-1.44 3.04-1.14 3.04-1.14.61 1.53.23 2.65.11 2.93.71.77 1.14 1.76 1.14 2.97 0 4.25-2.59 5.19-5.06 5.46.4.34.75 1.02.75 2.05v3.05c0 .3.2.64.76.53A11.1 11.1 0 0 0 12 .9Z" /></svg>
                            Source
                        </a>}
                    </div>
                    <div class="docs-api-prose prose prose-effect">
                        {record.categories.map((category) => <section class="docs-api-category" id={`category-${category.id}`}>
                            <h2>{category.label}</h2>
                            {declarationsFor(category.id).map((declaration) => <article class="docs-api-declaration" id={declaration.id}>
                                <div class="docs-declaration-heading">
                                    <h3><a class="docs-declaration-name" href={`#${declaration.id}`} aria-label={`Link to ${declaration.name}`}><svg class="docs-declaration-link-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>{declaration.name}</a><span class="docs-kind-badge">{declaration.kind.toUpperCase()}</span></h3>
                                    <div class="docs-declaration-links">
                                        <span>Added in v{declaration.introductionVersion ?? record.version}</span>
                                        {sourceHref(declaration.source) === undefined ? null : <a class="docs-source-link" href={sourceHref(declaration.source)} rel="noreferrer">Source<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M9.5 2.5h4v4M13.25 2.75 7 9m1-5H4.5A1.5 1.5 0 0 0 3 5.5v6A1.5 1.5 0 0 0 4.5 13h6a1.5 1.5 0 0 0 1.5-1.5V9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg></a>}
                                    </div>
                                </div>
                                <ApiReferenceDescription description={declaration.description} parts={declaration.descriptionParts} />
                                {declaration.examples?.map((example, index) => <section class="docs-api-example">
                                    <h4 class="docs-api-example-heading">Example{example.name === undefined ? null : <span>({example.name})</span>}</h4>
                                    <div class="docs-code-frame docs-signature-frame">
                                        <div class="docs-signature-output" set:html={exampleHtml.get(`${declaration.id}:${index}`)}></div>
                                        <button class="docs-code-copy" type="button" data-copy-code={example.code} data-copy-label="Copy example to clipboard" title="Copy to clipboard" aria-label="Copy example to clipboard">
                                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 4.5V4a1.5 1.5 0 0 0-1.5-1.5h-9A1.5 1.5 0 0 0 4 4v12A1.5 1.5 0 0 0 5.5 17.5H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                                        </button>
                                    </div>
                                </section>)}
                                <h4>Signature</h4>
                                <div class="docs-code-frame docs-signature-frame">
                                    <div class="docs-signature-output" set:html={signatures.get(declaration.id)}></div>
                                    <button class="docs-code-copy" type="button" data-copy-code={declaration.signature} data-copy-label="Copy signature to clipboard" title="Copy to clipboard" aria-label="Copy signature to clipboard">
                                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 4.5V4a1.5 1.5 0 0 0-1.5-1.5h-9A1.5 1.5 0 0 0 4 4v12A1.5 1.5 0 0 0 5.5 17.5H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                                    </button>
                                </div>
                            </article>)}
                        </section>)}
                    </div>
                </main>
                <aside class="docs-toc" aria-label="On this page">
                    <strong>On this page</strong>
                    <ul class="docs-nav-items">
                        {uncategorizedDeclarations.map((declaration) => <li><a href={`#${declaration.id}`}>{declaration.name}</a></li>)}
                        {declarationCategoryNames.map((category) => <li class="docs-toc-category"><span>{category}</span>
                            <ul>{declarationsInCategory(category).map((declaration) => <li><a href={`#${declaration.id}`}>{declaration.name}</a></li>)}</ul>
                        </li>)}
                    </ul>
                </aside>
            </div>
            <footer class="docs-footer">Generated from TypeDoc source comments.</footer>
        </div>
    </body>
</html>

<style is:global set:html={docsUiCss}></style>
<style is:global set:html={createThemeCss(DefaultDesignTokens)}></style>
<style is:global>
    :root { color-scheme: dark; }
    [data-theme="light"] { color-scheme: light; }
    body { margin: 0; }
    .docs-api-site { min-height: 100vh; }
    .docs-api-package { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.1rem; font-weight: 700; margin: 1.8rem 0 .3rem; overflow-wrap: anywhere; }
    .docs-api-version { color: var(--docs-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; margin: 0; }
    .docs-sidebar-group { margin-top: 2rem; }
    .docs-sidebar-group h3 { align-items: center; display: flex; font-size: .95rem; justify-content: space-between; margin: 0 0 .6rem; }
    .docs-sidebar-group h3 span { color: var(--docs-muted); }
    .docs-api-page .docs-sidebar .docs-nav-items a, .docs-api-page .docs-toc .docs-nav-items a { padding-left: 14px; }
    .docs-api-main { margin-inline: auto; max-width: 1050px; width: 100%; }
    .docs-api-main > .docs-breadcrumbs { margin-top: 34px; }
    .docs-api-page .docs-breadcrumbs { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.2px; font-weight: 400; }
    .docs-api-heading-row .docs-eyebrow { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.2px; }
    .docs-api-title-row { align-items: baseline; display: flex; gap: 24px; justify-content: space-between; }
    .docs-api-title-row h1 { font-weight: 700; }
    .docs-api-page .docs-toc .docs-nav-items a { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .docs-api-page .docs-sidebar .docs-nav-items a:hover, .docs-api-page .docs-sidebar .docs-nav-items a.is-active, .docs-api-page .docs-toc .docs-nav-items a:hover { background: var(--docs-code-background); }
    .docs-api-page > .docs-toc { align-self: start; max-height: calc(100vh - var(--docs-header-height, 72px)); overflow-y: auto; position: sticky; top: var(--docs-header-height, 72px); }
    .docs-api-page .docs-declaration-heading h3 { font-size: 25px; }
    .docs-declaration-name { align-items: center; color: inherit; cursor: pointer; display: inline-flex; gap: 0; position: relative; text-decoration: none; }
    .docs-declaration-link-icon { color: var(--docs-accent); height: 18px; left: -26px; opacity: 0; position: absolute; transition: opacity 120ms ease; width: 18px; }
    .docs-declaration-name:hover .docs-declaration-link-icon, .docs-declaration-name:focus-visible .docs-declaration-link-icon { opacity: 1; }
    .docs-api-meta { align-items: center; color: var(--docs-muted); display: flex; flex-wrap: wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; gap: 24px; margin: 28px 0 62px; }
    .docs-api-meta a, .docs-declaration-links a { color: var(--docs-accent); }
    .docs-declaration-links .docs-source-link { align-items: center; display: inline-flex; gap: 4px; text-decoration: none; white-space: nowrap; }
    .docs-kind-badge { display: inline-block; flex-shrink: 0; white-space: nowrap; }
    .docs-signature-output { flex: 1; min-width: 0; }
    .docs-signature-frame { margin: 1rem 0 0; }
    .docs-api-example { margin-top: 1.5rem; }
    .docs-api-example-heading { align-items: baseline; display: flex; gap: .45rem; margin: 0; }
    .docs-api-example-heading span { color: var(--docs-muted); font-weight: 400; }
    .docs-signature-output pre.shiki { background: transparent !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; box-sizing: border-box; color: var(--docs-foreground); font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.65; margin: 0 !important; max-width: none; overflow: auto; padding: 18px 60px 24px 20px; white-space: pre; }
    .docs-signature-output pre.shiki code { display: block; white-space: inherit; }
    .docs-signature-output pre.shiki .line { min-height: 1em; }
    .docs-signature-output pre.shiki span { color: var(--shiki-light); }
    [data-theme="dark"] .docs-signature-output pre.shiki span { color: var(--shiki-dark); }
    .docs-toc .docs-nav-items ul { list-style: none; margin: .5rem 0 0; padding-left: 1rem; }
    .docs-toc-category > span { color: var(--docs-foreground); display: block; font-size: 13px; font-weight: 650; margin: 12px 0 4px; }
</style>

<script is:inline>
    const copy = async (text) => {
        try { await navigator.clipboard.writeText(text); } catch { const area = document.createElement("textarea"); area.value = text; document.body.appendChild(area); area.select(); document.execCommand("copy"); area.remove(); }
    };
    document.querySelectorAll("[data-copy-llm]").forEach((button) => button.addEventListener("click", async () => { await copy(button.dataset.copyText ?? ""); button.dataset.copied = "true"; button.setAttribute("aria-label", "Copied markdown!"); window.setTimeout(() => { button.dataset.copied = "false"; button.setAttribute("aria-label", "Copy for LLM"); }, 1600); }));
    const copyIcon = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="12" height="14" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M16 4.5V4a1.5 1.5 0 0 0-1.5-1.5h-9A1.5 1.5 0 0 0 4 4v12A1.5 1.5 0 0 0 5.5 17.5H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
    const copiedIcon = '<svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    const addCopyButton = (frame, code) => {
        if (frame.querySelector("[data-copy-code]")) return;
        const button = document.createElement("button");
        button.className = "docs-code-copy";
        button.type = "button";
        button.title = "Copy to clipboard";
        button.setAttribute("aria-label", "Copy code to clipboard");
        button.innerHTML = copyIcon;
        frame.appendChild(button);
        button.addEventListener("click", async () => {
            await copy(code);
            button.dataset.copied = "true";
            button.innerHTML = copiedIcon;
            button.setAttribute("aria-label", "Copied to clipboard");
            window.setTimeout(() => {
                button.dataset.copied = "false";
                button.innerHTML = copyIcon;
                button.setAttribute("aria-label", "Copy code to clipboard");
            }, 1600);
        });
    };
    document.querySelectorAll("[data-copy-code]").forEach((button) => button.addEventListener("click", async () => {
        await copy(button.dataset.copyCode ?? "");
        button.dataset.copied = "true";
        button.innerHTML = copiedIcon;
        button.setAttribute("aria-label", "Copied to clipboard");
        window.setTimeout(() => { button.dataset.copied = "false"; button.innerHTML = copyIcon; button.setAttribute("aria-label", button.dataset.copyLabel ?? "Copy code to clipboard"); }, 1600);
    }));
    document.querySelectorAll(".docs-prose pre").forEach((pre) => {
        const frame = document.createElement("div");
        frame.className = "docs-code-frame";
        pre.parentNode.insertBefore(frame, pre);
        frame.appendChild(pre);
        addCopyButton(frame, pre.innerText);
    });
</script>
