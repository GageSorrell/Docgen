---
import type { ApiReferenceRecord } from "@sorrell/docs-core";
import { recordToAgentDocument } from "@sorrell/docs-api-reference";
import { DefaultDesignTokens, formatAgentDocument } from "@sorrell/docs-core";
import { canonicalUrl } from "@sorrell/docs-astro";
import { createThemeCss, docsUiCss } from "@sorrell/docs-ui";
import { createHighlighter } from "shiki";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/docs.css";

interface Props
{
    readonly record: ApiReferenceRecord;
}

const { record } = Astro.props as Props;
const document = recordToAgentDocument(record);
const copyText = formatAgentDocument({ ...document, url: new URL(Astro.url.pathname, "https://docs.sorrell.sh").toString() });
const canonicalPath = Astro.url.pathname;
const canonical = canonicalUrl("https://docs.sorrell.sh", canonicalPath);
const sourceHref = (source: ApiReferenceRecord["source"]): string | undefined => source === undefined ? undefined : `${source.repositoryUrl}/blob/${source.revision}/${source.file}${source.line === undefined ? "" : `#L${source.line}`}`;
const declarationsFor = (categoryId: string) => record.declarations.filter((declaration) => declaration.categoryId === categoryId);
const highlighter = await createHighlighter({
    langs: ["typescript"],
    themes: ["github-light", "github-dark"]
});
const signatures = new Map(record.declarations.map((declaration) => [
    declaration.id,
    highlighter.codeToHtml(declaration.signature, {
        lang: "typescript",
        themes: { dark: "github-dark", light: "github-light" },
        defaultColor: false
    })
]));
highlighter.dispose();
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={record.summary} />
        <meta property="og:description" content={record.summary} />
        <meta property="og:title" content={`${record.displayName} · API Reference`} />
        <link rel="canonical" href={canonical} />
        <link rel="alternate" type="text/markdown" href={`${canonicalPath}.md`} />
        <title>{record.displayName} · API Reference</title>
    </head>
    <body>
        <div class="docs-site docs-api-site">
            <SiteHeader />
            <div class="docs-api-page">
                <aside class="docs-sidebar" aria-label="API reference navigation">
                    <div class="docs-sidebar-label">API REFERENCE</div>
                    <h2 class="docs-api-package">{record.packageName}</h2>
                    <p class="docs-api-version">{record.version}</p>
                    {record.categories.map((category) => <section class="docs-sidebar-group">
                        <h3>{category.label}<span aria-hidden="true">⌃</span></h3>
                        <ul class="docs-nav-items">
                            {declarationsFor(category.id).map((declaration) => <li><a href={`#${declaration.id}`}>{declaration.name}</a></li>)}
                        </ul>
                    </section>)}
                </aside>
                <main class="docs-api-main" id="main-content">
                    <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
                        {record.breadcrumbs.map((breadcrumb, index) => <>
                            {index === 0 ? null : <span class="docs-breadcrumb-separator">/</span>}
                            {breadcrumb.current || breadcrumb.href === undefined ? <span>{breadcrumb.label}</span> : <a href={breadcrumb.href}>{breadcrumb.label}</a>}
                        </>)}
                    </nav>
                    <div class="docs-api-heading-row">
                        <div>
                            <p class="docs-eyebrow">API REFERENCE</p>
                            <h1>{record.displayName}</h1>
                            <div class="prose prose-effect"><p>{record.summary}</p></div>
                        </div>
                        <button class="docs-copy-button" type="button" data-copy-llm data-copy-text={copyText}>Copy for LLM</button>
                    </div>
                    <div class="docs-api-meta">
                        <span>{record.exportCount} exports</span>
                        {record.introductionVersion === undefined ? null : <span>Added in {record.introductionVersion}</span>}
                        {sourceHref(record.source) === undefined ? null : <a href={sourceHref(record.source)} rel="noreferrer">◉ Source ↗</a>}
                    </div>
                    <div class="docs-api-prose prose prose-effect">
                        {record.categories.map((category) => <section class="docs-api-category" id={`category-${category.id}`}>
                            <h2>{category.label}</h2>
                            {declarationsFor(category.id).map((declaration) => <article class="docs-api-declaration" id={declaration.id}>
                                <div class="docs-declaration-heading">
                                    <h3>{declaration.name}<span class="docs-kind-badge">{declaration.kind.toUpperCase()}</span></h3>
                                    <div class="docs-declaration-links">
                                        {declaration.introductionVersion === undefined ? null : <span>Added in {declaration.introductionVersion}</span>}
                                        {sourceHref(declaration.source) === undefined ? null : <a href={sourceHref(declaration.source)} rel="noreferrer">Source ↗</a>}
                                        <a href={`#${declaration.id}`}>#</a>
                                    </div>
                                </div>
                                <p>{declaration.description}</p>
                                <h4>Signature</h4>
                                <div class="docs-signature-row">
                                    <div class="docs-signature-output" set:html={signatures.get(declaration.id)}></div>
                                    <button class="docs-signature-copy" type="button" data-copy-signature={declaration.signature}>Copy</button>
                                </div>
                            </article>)}
                        </section>)}
                    </div>
                </main>
                <aside class="docs-toc" aria-label="On this page">
                    <strong>On this page</strong>
                    <ul class="docs-nav-items">
                        {record.categories.map((category) => <li><a href={`#category-${category.id}`}>{category.label}</a>
                            <ul>{declarationsFor(category.id).map((declaration) => <li><a href={`#${declaration.id}`}>{declaration.name}</a></li>)}</ul>
                        </li>)}
                    </ul>
                </aside>
            </div>
            <footer class="docs-footer">Generated from TypeDoc source comments.</footer>
        </div>
    </body>
</html>

<style is:global set:html={docsUiCss}></style>
<style is:global set:html={createThemeCss(DefaultDesignTokens)}></style>
<style is:global>
    :root { color-scheme: dark; }
    [data-theme="light"] { color-scheme: light; }
    body { margin: 0; }
    .docs-api-site { min-height: 100vh; }
    .docs-api-package { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.1rem; margin: 1.8rem 0 .3rem; overflow-wrap: anywhere; }
    .docs-api-version { color: var(--docs-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; margin: 0; }
    .docs-sidebar-group { margin-top: 2rem; }
    .docs-sidebar-group h3 { align-items: center; display: flex; font-size: .95rem; justify-content: space-between; margin: 0 0 .6rem; }
    .docs-sidebar-group h3 span { color: var(--docs-muted); }
    .docs-api-main { max-width: 1050px; }
    .docs-api-main > .docs-breadcrumbs { margin-top: 34px; }
    .docs-api-meta { align-items: center; color: var(--docs-muted); display: flex; flex-wrap: wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; gap: 24px; margin: 28px 0 62px; }
    .docs-api-meta a, .docs-declaration-links a { color: var(--docs-accent); }
    .docs-signature-row { align-items: start; display: flex; gap: 10px; }
    .docs-signature-output { flex: 1; min-width: 0; }
    .docs-signature-output pre.shiki { background: var(--docs-code-background) !important; border: 1px solid var(--docs-border); border-radius: 8px; box-sizing: border-box; color: var(--docs-foreground); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.65; margin: 0; max-width: 100%; overflow: auto; padding: 16px; white-space: pre; }
    .docs-signature-output pre.shiki code { display: block; white-space: inherit; }
    .docs-signature-output pre.shiki .line { min-height: 1em; }
    .docs-signature-output pre.shiki span { color: var(--shiki-light); }
    [data-theme="dark"] .docs-signature-output pre.shiki span { color: var(--shiki-dark); }
    .docs-signature-copy { background: transparent; border: 1px solid var(--docs-border); border-radius: 6px; color: var(--docs-muted); cursor: pointer; padding: 7px 9px; }
    .docs-signature-copy:hover, .docs-signature-copy:focus-visible { border-color: var(--docs-accent); color: var(--docs-foreground); }
    .docs-toc .docs-nav-items ul { list-style: none; margin: .5rem 0 0; padding-left: 1rem; }
    @media (max-width: 780px) { .docs-signature-row { display: block; } .docs-signature-copy { margin-top: 6px; } }
</style>

<script is:inline>
    const copy = async (text) => {
        try { await navigator.clipboard.writeText(text); } catch { const area = document.createElement("textarea"); area.value = text; document.body.appendChild(area); area.select(); document.execCommand("copy"); area.remove(); }
    };
    document.querySelectorAll("[data-copy-llm]").forEach((button) => button.addEventListener("click", async () => { await copy(button.dataset.copyText ?? ""); button.dataset.copied = "true"; button.textContent = "Copied"; window.setTimeout(() => { button.dataset.copied = "false"; button.textContent = "Copy for LLM"; }, 1600); }));
    document.querySelectorAll("[data-copy-signature]").forEach((button) => button.addEventListener("click", async () => { await copy(button.dataset.copySignature ?? ""); button.textContent = "Copied"; window.setTimeout(() => { button.textContent = "Copy"; }, 1600); }));
</script>
