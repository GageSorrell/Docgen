---
import type { ApiReferenceDataset } from "@sorrell/docs-api-reference";
import dataset from "../../data/ApiReference.json";
import DocsLayout from "../../layouts/DocsLayout.astro";

const apiDataset = dataset as ApiReferenceDataset;
const packages = [ ...new Map(apiDataset.records.map((record) => [record.packageId, record])).values()];
const schemas = apiDataset.jsonSchemas ?? [];
const docsPrefix = import.meta.env.BASE_URL.replace(/\/$/u, "");
const pages = [ ...packages.map((record) => ({ description: record.packageDescription ?? "", group: "API Reference", id: record.packageId, slug: `api/${record.packageId}`, title: record.packageName })), ...schemas.map((record) => ({ description: record.description ?? "JSON Schema reference", group: "JSON Schemas", id: record.route, slug: record.route.replace(/^\/docs\/?/u, ""), title: record.title })) ];
---

<DocsLayout
    canonicalPath={`${docsPrefix}/api`}
    copyText={`# API Reference\n\n${packages.map((record) => [record.packageName, record.packageDescription].filter(Boolean).join("\n")).join("\n\n")}`}
    description="Browse package API references."
    headings={[]}
    pages={pages}
    slug="api"
    title="API Reference"
>
    <h1>API Reference</h1>
    <p>Browse generated API reference pages for documented packages.</p>
    <div class="docs-api-package-grid">
        {packages.map((record) => <a class="docs-api-package-card" href={`${docsPrefix}/api/${record.packageId}`}>
            <h2>{record.packageName}</h2>
        </a>)}
    </div>
    {schemas.length ? <><h2>JSON Schemas</h2><div class="docs-api-package-grid">{schemas.map((record) => <a class="docs-api-package-card" href={record.route}><h2>{record.title}</h2>{record.description ? <p>{record.description}</p> : null}</a>)}</div></> : null}
</DocsLayout>

<style is:global>
    .docs-api-package-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); margin-top: 28px; }
    .docs-api-package-card, .docs-api-package-card * { text-decoration: none !important; }
    .docs-api-package-card { background: var(--docs-card-background); border: 1px solid var(--docs-border); border-radius: 10px; color: var(--docs-foreground); padding: 18px; }
    .docs-api-package-card:hover { border-color: var(--docs-accent); }
    .docs-api-package-card h2 { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1rem; margin: 0; }
</style>
